  "parches": [
    {
      "decision": "unirse_a_startup",
      "opcion": "ir",
      "resultado": "crece",
      "texto_al_ocurrir": "Te vas a la startup con acciones. El desenlace se sabrá con los años.",
      "quitar_efectos": [
        "ahorro"
      ],
      "agregar_efectos": [
        {
          "var": "exit_en",
          "op": "fija",
          "valor": "azar_entero(3, 5)"
        },
        {
          "var": "destino_startup",
          "op": "fija",
          "valor": 1
        }
      ],
      "motivo": "En el paquete las acciones pagan solo si anos_en_startup >= 4 al momento de entrar, que nunca se cumple. El motor guarda el desenlace sorteado y paga la venta 3 a 5 años después si sigues ahí."
    },
    {
      "decision": "unirse_a_startup",
      "opcion": "ir",
      "resultado": "cierra",
      "texto_al_ocurrir": "Te vas a la startup con acciones. El desenlace se sabrá con los años.",
      "agregar_efectos": [
        {
          "var": "destino_startup",
          "op": "fija",
          "valor": 1
        }
      ],
      "motivo": "El desenlace (cierra en 1 a 4 años) ya quedó sorteado; no se le suma el evento startup_cierra."
    },
    {
      "decision": "unirse_a_startup",
      "opcion": "ir",
      "resultado": "sigue",
      "texto_al_ocurrir": "Te vas a la startup con acciones. El desenlace se sabrá con los años.",
      "agregar_efectos": [
        {
          "var": "destino_startup",
          "op": "fija",
          "valor": 1
        }
      ],
      "motivo": "Idem: el desenlace ya quedó sorteado."
    },
    {
      "decision": "emprender",
      "opcion": "emprender",
      "resultado": "parte",
      "quitar_efectos": [
        "sueldo_ref"
      ],
      "agregar_efectos": [
        {
          "var": "sueldo_ref",
          "op": "fija",
          "valor": "max(sueldo, sueldo_ref)"
        }
      ],
      "motivo": "El paquete guarda sueldo_ref = sueldo. Quien emprende estando sin pega tiene sueldo 0 y perdería su sueldo de referencia; se conserva el mayor, igual que hace el paquete en sabatico."
    },
    {
      "decision": "cesantia",
      "opcion": "rapido",
      "resultado": "nada",
      "quitar_efectos": [
        "ahorro"
      ],
      "motivo": "El costo de un año sin ingreso lo aplica el motor a todos los caminos con la misma fórmula del paquete (regla costo_sin_ingreso), no solo a esta opción."
    }
  ],
